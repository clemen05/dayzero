{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DayZero: exportar datos (SQLite -> src/data.js)",
      "type": "shell",
      "command": "python tools/export_data.py data/dayzero.sqlite",
      "problemMatcher": []
    },
    {
      "label": "DayZero: build (-> dist/index.html)",
      "type": "shell",
      "command": "python tools/build.py",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "DayZero: tests del motor",
      "type": "shell",
      "command": "node --test tests/engine.test.js",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "DayZero: tests de aceptación (navegador)",
      "type": "shell",
      "command": "npm run e2e",
      "dependsOn": "DayZero: build (-> dist/index.html)",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "DayZero: abrir la app",
      "type": "shell",
      "windows": { "command": "start \"\" \"${workspaceFolder}\\dist\\index.html\"" },
      "osx": { "command": "open dist/index.html" },
      "linux": { "command": "xdg-open dist/index.html" },
      "dependsOn": "DayZero: build (-> dist/index.html)",
      "problemMatcher": []
    }
  ]
}
