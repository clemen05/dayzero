# Variables de entorno de DayZero. En Render: Settings → Environment → Add Environment Variable.
# Ninguna es obligatoria para arrancar en local; sin ellas, la app funciona con valores por defecto.

# Firma de las cookies de sesión (HU-22). Pon un texto largo y aleatorio. Sin él, las sesiones se pierden al reiniciar.
SESSION_SECRET=

# Base de datos PostgreSQL para cuentas y partidas (HU-22, HU-23). Sin ella se usa storage/dayzero-store.json,
# que en Render se borra en cada despliegue. Ejemplo (Neon): postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=

# Narración con IA (HU-18). Sin clave, se usan los textos de reserva (HU-19).
ANTHROPIC_API_KEY=
# NARRADOR_MODELO=claude-haiku-5-5
# NARRADOR_TIMEOUT_MS=5000

# Inicio de sesión con Google (HU-26). URI de redirección: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Inicio de sesión con Microsoft (HU-26). URI de redirección: https://TU-DOMINIO/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dirección pública de la web, si no se detecta sola (por ejemplo, https://dayzero-0ms1.onrender.com)
# BASE_URL=
